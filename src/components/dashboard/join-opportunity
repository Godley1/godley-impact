"use client";

import { useState } from "react";
import { createClient } from "@/utils/supabase/client";

type JoinOpportunityButtonProps = {
  opportunityId: string;
};

export default function JoinOpportunityButton({
  opportunityId,
}: JoinOpportunityButtonProps) {
  const supabase = createClient();
  const [isJoining, setIsJoining] = useState(false);
  const [message, setMessage] = useState("");

  async function handleJoin() {
    setIsJoining(true);
    setMessage("");

    const {
      data: { user },
      error: userError,
    } = await supabase.auth.getUser();

    if (userError || !user?.id) {
      setMessage("You must be logged in to join.");
      setIsJoining(false);
      return;
    }

    const { error } = await supabase.from("opportunity_signups").insert({
      opportunity_id: opportunityId,
      user_id: user.id,
    });

    if (error) {
      if (error.code === "23505") {
        setMessage("You already joined this opportunity.");
      } else {
        setMessage("Could not join opportunity.");
      }
      setIsJoining(false);
      return;
    }

    setMessage("You joined this opportunity.");
    setIsJoining(false);
  }

  return (
    <div className="pt-2">
      <button
        type="button"
        onClick={handleJoin}
        disabled={isJoining}
        className="rounded-xl bg-gray-900 px-4 py-2 text-sm font-medium text-white transition hover:bg-gray-800 disabled:cursor-not-allowed disabled:opacity-60"
      >
        {isJoining ? "Joining..." : "Join Opportunity"}
      </button>

      {message && (
        <p className="mt-2 text-sm text-gray-600">{message}</p>
      )}
    </div>
  );
}